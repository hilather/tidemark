{
  "id": null,
  "uid": "tidemark",
  "title": "Tidemark disk usage",
  "tags": [
    "tidemark"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "1m",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "label": "Prometheus"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Filesystem used and available",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "options": {},
      "targets": [
        {
          "refId": "A",
          "expr": "tidemark_fs_used_bytes",
          "legendFormat": "{{mount}}{{vg}}{{pool}}{{path}}",
          "instant": false,
          "format": "time_series"
        },
        {
          "refId": "B",
          "expr": "tidemark_fs_avail_bytes",
          "legendFormat": "{{mount}}{{vg}}{{pool}}{{path}}",
          "instant": false,
          "format": "time_series"
        }
      ]
    },
    {
      "id": 2,
      "title": "Time to full",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {},
      "targets": [
        {
          "refId": "A",
          "expr": "tidemark_fs_time_to_full_seconds",
          "legendFormat": "{{mount}}{{vg}}{{pool}}{{path}}",
          "instant": false,
          "format": "time_series"
        }
      ]
    },
    {
      "id": 3,
      "title": "Thin pool data and metadata",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        },
        "overrides": []
      },
      "options": {},
      "targets": [
        {
          "refId": "A",
          "expr": "tidemark_lvm_thin_data_percent",
          "legendFormat": "{{mount}}{{vg}}{{pool}}{{path}}",
          "instant": false,
          "format": "time_series"
        },
        {
          "refId": "B",
          "expr": "tidemark_lvm_thin_metadata_percent",
          "legendFormat": "{{mount}}{{vg}}{{pool}}{{path}}",
          "instant": false,
          "format": "time_series"
        }
      ]
    },
    {
      "id": 4,
      "title": "Volume group free",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "options": {},
      "targets": [
        {
          "refId": "A",
          "expr": "tidemark_lvm_vg_free_bytes",
          "legendFormat": "{{mount}}{{vg}}{{pool}}{{path}}",
          "instant": false,
          "format": "time_series"
        }
      ]
    },
    {
      "id": 5,
      "title": "Directory sizes over time",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "options": {},
      "targets": [
        {
          "refId": "A",
          "expr": "tidemark_dir_used_bytes",
          "legendFormat": "{{mount}}{{vg}}{{pool}}{{path}}",
          "instant": false,
          "format": "time_series"
        }
      ]
    },
    {
      "id": 6,
      "title": "Top directories",
      "type": "table",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "options": {},
      "targets": [
        {
          "refId": "A",
          "expr": "topk(10, tidemark_dir_used_bytes)",
          "legendFormat": "{{mount}}{{vg}}{{pool}}{{path}}",
          "instant": true,
          "format": "table"
        }
      ]
    },
    {
      "id": 7,
      "title": "Phantom bytes",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "options": {},
      "targets": [
        {
          "refId": "A",
          "expr": "tidemark_phantom_bytes",
          "legendFormat": "{{mount}}{{vg}}{{pool}}{{path}}",
          "instant": false,
          "format": "time_series"
        }
      ]
    },
    {
      "id": 8,
      "title": "Scan freshness",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {},
      "targets": [
        {
          "refId": "A",
          "expr": "time() - tidemark_scan_last_success_timestamp_seconds",
          "legendFormat": "{{mount}}{{vg}}{{pool}}{{path}}",
          "instant": false,
          "format": "time_series"
        }
      ]
    },
    {
      "id": 9,
      "title": "Watcher health",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "options": {},
      "targets": [
        {
          "refId": "A",
          "expr": "rate(tidemark_watch_events_total[5m])",
          "legendFormat": "{{mount}}{{vg}}{{pool}}{{path}}",
          "instant": false,
          "format": "time_series"
        },
        {
          "refId": "B",
          "expr": "increase(tidemark_watch_overflows_total[15m])",
          "legendFormat": "{{mount}}{{vg}}{{pool}}{{path}}",
          "instant": false,
          "format": "time_series"
        }
      ]
    }
  ]
}
